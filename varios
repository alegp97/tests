Ejemplos que deben funcionar

La tool debe poder manejar casos como estos:

Ejemplo 1: join simple

SELECT
    c.CLIENT_ID,
    c.CLIENT_NAME,
    o.ORDER_ID,
    o.AMOUNT
FROM DEDJAN.CLIENTES c
JOIN DEDJAN.ORDERS o
    ON o.CLIENT_ID = c.CLIENT_ID
WHERE o.AMOUNT > :min_amount
ORDER BY o.AMOUNT DESC

Params:

{
  "min_amount": 1000
}

Ejemplo 2: CTE

WITH recent_orders AS (
    SELECT
        ORDER_ID,
        CLIENT_ID,
        AMOUNT,
        CREATED_AT
    FROM DEDJAN.ORDERS
    WHERE CREATED_AT >= :from_date
)
SELECT
    c.CLIENT_ID,
    c.CLIENT_NAME,
    COUNT(ro.ORDER_ID) AS NUM_ORDERS,
    SUM(ro.AMOUNT) AS TOTAL_AMOUNT
FROM DEDJAN.CLIENTES c
JOIN recent_orders ro
    ON ro.CLIENT_ID = c.CLIENT_ID
GROUP BY
    c.CLIENT_ID,
    c.CLIENT_NAME
HAVING SUM(ro.AMOUNT) > :min_total
ORDER BY TOTAL_AMOUNT DESC

Params:

{
  "from_date": "2025-01-01",
  "min_total": 5000
}

Ejemplo 3: subquery

SELECT
    c.CLIENT_ID,
    c.CLIENT_NAME
FROM DEDJAN.CLIENTES c
WHERE c.CLIENT_ID IN (
    SELECT o.CLIENT_ID
    FROM DEDJAN.ORDERS o
    WHERE o.AMOUNT > :min_amount
)

Params:

{
  "min_amount": 1000
}

Ejemplo 4: window function

SELECT
    o.CLIENT_ID,
    o.ORDER_ID,
    o.AMOUNT,
    ROW_NUMBER() OVER (
        PARTITION BY o.CLIENT_ID
        ORDER BY o.AMOUNT DESC
    ) AS RN
FROM DEDJAN.ORDERS o
WHERE o.CREATED_AT >= :from_date

Params:

{
  "from_date": "2025-01-01"
}
