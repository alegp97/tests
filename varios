-- Databricks notebook source
-- MAGIC %sql
-- 3) Vista temporal filtrada por parámetros (para reutilizar en consultas)
CREATE OR REPLACE TEMP VIEW v_trips_filtered AS
SELECT *
FROM trips
WHERE
  to_date(tpep_pickup_datetime) BETWEEN to_date('${date_from}') AND to_date('${date_to}')
  AND fare_amount >= CAST('${min_fare}' AS DOUBLE)
  AND trip_distance <= CAST('${max_dist}' AS DOUBLE)
  AND trip_distance >= 0
  AND total_amount IS NOT NULL;

SELECT COUNT(*) AS trips_filtrados FROM v_trips_filtered;




-- Databricks notebook source
-- MAGIC %sql
-- 4) KPIs principales (funcional)
SELECT
  COUNT(*)                                                   AS trips,
  ROUND(AVG(trip_distance), 2)                               AS avg_miles,
  ROUND(APPROX_PERCENTILE(trip_distance, 0.5), 2)            AS p50_miles,
  ROUND(AVG(total_amount), 2)                                AS avg_total_amount,
  ROUND(SUM(total_amount), 2)                                AS total_revenue,
  ROUND(SUM(CASE WHEN payment_type = 1 THEN 1 ELSE 0 END)
        / COUNT(*) * 100, 2)                                 AS pct_card_payments,  -- 1=Card (común en yellow taxi)
  ROUND(SUM(CASE WHEN tip_amount > 0 THEN 1 ELSE 0 END)
        / COUNT(*) * 100, 2)                                 AS pct_with_tip
FROM v_trips_filtered;





-- Databricks notebook source
-- MAGIC %sql
-- 5) Distribución horaria (demanda por franja)
SELECT
  date_format(tpep_pickup_datetime, 'EEEE')           AS weekday_name,
  hour(tpep_pickup_datetime)                          AS pickup_hour,
  COUNT(*)                                            AS trips
FROM v_trips_filtered
GROUP BY 1, 2
ORDER BY
  -- Ordenar por día de la semana (L->D) y hora
  CASE date_format(tpep_pickup_datetime, 'u')
    WHEN '1' THEN 1 WHEN '2' THEN 2 WHEN '3' THEN 3
    WHEN '4' THEN 4 WHEN '5' THEN 5 WHEN '6' THEN 6
    ELSE 7 END,
  pickup_hour;




-- Databricks notebook source
-- MAGIC %sql
-- 6) Mix de formas de pago
-- (payment_type: 1=Card, 2=Cash, 3=No charge, 4=Dispute, 5=Unknown, 6=Voided)
SELECT
  payment_type,
  COUNT(*)                    AS trips,
  ROUND(AVG(total_amount),2)  AS avg_ticket,
  ROUND(SUM(total_amount),2)  AS revenue
FROM v_trips_filtered
GROUP BY payment_type
ORDER BY trips DESC;




-- Databricks notebook source
-- MAGIC %sql
-- 7) Top zonas de recogida (si existe el lookup de zonas)
-- En muchos workspaces la tabla de zonas es `samples.nyctaxi.taxi_zone_lookup`
-- con columnas: LocationID, Borough, Zone, service_zone.
-- Si no existe en tu entorno, ejecuta el SELECT sin JOIN y muestra sólo PULocationID.
WITH agg AS (
  SELECT
    PULocationID,
    COUNT(*) AS trips,
    ROUND(AVG(total_amount),2) AS avg_ticket
  FROM v_trips_filtered
  GROUP BY PULocationID
)
SELECT
  a.PULocationID,
  z.Borough,
  z.Zone,
  a.trips,
  a.avg_ticket
FROM agg a
LEFT JOIN samples.nyctaxi.taxi_zone_lookup z
  ON a.PULocationID = z.LocationID
ORDER BY a.trips DESC
LIMIT 15;






-- Databricks notebook source
-- MAGIC %sql
-- 8) “Rutas calientes”: top combinaciones Origen-Destino
SELECT
  PULocationID,
  DOLocationID,
  COUNT(*) AS trips,
  ROUND(AVG(trip_distance),2) AS avg_miles,
  ROUND(AVG(total_amount),2)  AS avg_ticket
FROM v_trips_filtered
GROUP BY PULocationID, DOLocationID
HAVING COUNT(*) >= 50
ORDER BY trips DESC
LIMIT 20;







-- Databricks notebook source
-- MAGIC %sql
-- 9) Ranking por zona de origen: Top 3 destinos por volumen (ventanas)
WITH base AS (
  SELECT
    PULocationID,
    DOLocationID,
    COUNT(*) AS trips
  FROM v_trips_filtered
  GROUP BY PULocationID, DOLocationID
),
ranked AS (
  SELECT
    PULocationID,
    DOLocationID,
    trips,
    DENSE_RANK() OVER (PARTITION BY PULocationID ORDER BY trips DESC) AS rnk
  FROM base
)
SELECT *
FROM ranked
WHERE rnk <= 3
ORDER BY PULocationID, rnk, trips DESC;







