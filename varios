dur = (datetime.datetime.now() - EXEC["started"]).total_seconds()
rows = []
for s in EXEC["steps"]:
    status = "OK ✅" if s["ok"] else "ERROR ❌"
    err = html.escape(s["err"])
    trace = html.escape(s["trace"])
    note = html.escape(s["note"])
    rows.append(f"""
      <tr>
        <td>{html.escape(s["name"])}</td>
        <td>{status}</td>
        <td>{note or "-"}</td>
      </tr>
      {f"<tr><td colspan='3'><pre>{trace}</pre></td></tr>" if not s["ok"] else ""}
    """)

html_out = f"""
<style>
  body{{font-family:Arial, sans-serif}}
  table{{border-collapse:collapse;width:100%}}
  th,td{{border:1px solid #ddd;padding:8px;vertical-align:top}}
  th{{background:#f6f6f6;text-align:left}}
  pre{{white-space:pre-wrap;overflow:auto}}
  .meta{{color:#555;font-size:12px;margin:6px 0}}
</style>
<h2>Resumen de ejecución</h2>
<div class="meta">Inicio: {EXEC["started"]:%Y-%m-%d %H:%M:%S} · Duración: {dur:.1f}s</div>
<table>
  <thead><tr><th>Paso</th><th>Estado</th><th>Nota</th></tr></thead>
