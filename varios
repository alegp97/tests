@RunWith(PowerMockRunner.class)
@PrepareForTest({
    JDBCHandler.class,
    HSSFRichTextString.class,
    HSSFCell.class,
    HSSFRow.class,
    HSSFSheet.class,
    PersistenceHandlerFactory.class,
    JDBCExecutorHandler.class,
    Detail.class,
    Table.class,
    Logger.class,
    HSSFFont.class,
    HSSFCellStyle.class,
    HSSFWorkbook.class,
    WorkbookTabManager.class
})
@SuppressStaticInitializationFor({
    // ya lo tenías:
    "com.santander.supra.core.utils.DataProperties",
    "com.santander.supra.core.datalake.hive.JDBCHandler",
    // 🔴 mínimo para cortar el NoSuchMethodError del log4j en <clinit>
    "com.santander.stresstest.extractor.workbook.WorkbookTabManager"
})
public class WorkbookTabManagerTest {

    @Mock HSSFWorkbook hssfWorkbook;
    @Mock HSSFCellStyle hssfCellStyle;
    @Mock HSSFSheet hssfSheet;
    @Mock HSSFFont hssfFont;

    @Mock Table table;
    @Mock HSSFRow row;
    @Mock HSSFCell cell;

    @Mock SessionWrapper session;
    @Mock Execution execution;

    @Mock PersistenceHandler pHandler;

    @Mock JDBCExecutorHandler jdbcExecutorHandler;

    List<Map<String, Object>> resultQueryExecution = new ArrayList<>();

    private static final String strResult = "true";
    private static final String sqlStatement = "select * from table";
    private static final String typeValidation = "VT";

    @Before
    public void beforeMethod() throws Exception {

        // --- POI base ---
        PowerMockito.mock(HSSFWorkbook.class);
        PowerMockito.when(hssfWorkbook.createCellStyle()).thenReturn(hssfCellStyle);
        PowerMockito.when(hssfWorkbook.createFont()).thenReturn(hssfFont);

        row = PowerMockito.mock(HSSFRow.class);

        // ✅ cubre overloads: en tu código hay createRow((short)0) pero POI muchas veces llama createRow(int)
        PowerMockito.when(hssfSheet.createRow(Mockito.anyInt())).thenReturn(row);
        PowerMockito.when(hssfSheet.createRow(Mockito.anyShort())).thenReturn(row);

        // ✅ cubre overloads: createCell(short) y createCell(int)
        PowerMockito.when(row.createCell(Mockito.anyInt())).thenReturn(cell);
        PowerMockito.when(row.createCell(Mockito.anyShort())).thenReturn(cell);

        // ✅ si el código usa getLastRowNum() (en detailedTable), evita NPE/valores raros
        PowerMockito.when(hssfSheet.getLastRowNum()).thenReturn(0);

        // --- table ---
        table = PowerMockito.mock(Table.class);
        PowerMockito.when(table.getNombreTabla()).thenReturn("tabla_origen");

        // --- persistence ---
        PowerMockito.mockStatic(PersistenceHandlerFactory.class);
        BDDMockito.given(PersistenceHandlerFactory.getPersistenceHandler()).willReturn(pHandler);

        // --- JDBCHandler (connection) ---
        PowerMockito.mockStatic(JDBCHandler.class);
        Connection con = PowerMockito.mock(Connection.class);
        PowerMockito.when(JDBCHandler.getConnection(JDBCHandler.HIVE)).thenReturn(con);

        // --- JDBCExecutorHandler singleton ---
        PowerMockito.mockStatic(JDBCExecutorHandler.class);
        PowerMockito.when(JDBCExecutorHandler.getInstance()).thenReturn(jdbcExecutorHandler);

        // ✅ devuelve lista NO vacía para que fillDetails / loops no revienten
        Map<String, Object> objectMapHive = new HashMap<>();
        objectMapHive.put("dummy", "dummy");
        resultQueryExecution.add(objectMapHive);

        PowerMockito.when(
            JDBCExecutorHandler.getInstance().launchQueriesAndGetRows(
                Mockito.eq(execution),
                Mockito.eq(session),
                Mockito.eq(con),
                Mockito.anyString(),
                Mockito.anyBoolean(),
                Mockito.anyBoolean(),
                Mockito.eq(JDBCHandler.HIVE)
            )
        ).thenReturn(resultQueryExecution);

        // --- Logger: como hemos suprimido <clinit>, logger estático queda null -> lo inyectamos ---
        PowerMockito.mockStatic(Logger.class);
        Logger log = PowerMockito.mock(Logger.class);
        PowerMockito.when(Logger.getLogger(WorkbookTabManager.class)).thenReturn(log);

        // 🔥 este es EL fix para el NPE en logger.info(...) cuando <clinit> no corrió
        org.powermock.reflect.Whitebox.setInternalState(WorkbookTabManager.class, "logger", log);
    }

    @Test
    public void generateSummaryTableTest() throws Exception {
        WorkbookTabManager.generateSummaryTable(table, hssfWorkbook, hssfSheet);
        assertEquals("true", strResult);
    }

    @Test
    public void generateDetailedTableTest() throws Exception {
        WorkbookTabManager.generateDetailedTable(
            sqlStatement, table, hssfWorkbook, hssfSheet, typeValidation, execution, session
        );
        assertEquals("true", strResult);
    }
}
