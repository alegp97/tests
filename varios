for bdr in BDRS:
    print(f"\n==== Ejecutando {PY_PATH} --bdr {bdr} --value_date {VALUE_DATE} ====")
    t0 = time.time()
    try:
        runpy.run_path(
            PY_PATH,
            run_globals={
                "__name__": "__main__",
                "__argv__": ["--bdr", bdr, "--value_date", VALUE_DATE],
                "spark": spark,  # <-- inyectamos el SparkSession creado en el launcher
            },
        )
        dt = round(time.time() - t0, 2)
        print(f"[OK] {bdr} en {dt}s")
        results.append((bdr, "OK", dt, ""))
    except SystemExit as e:
        dt = round(time.time() - t0, 2)
        results.append((bdr, "ERROR", dt, f"argparse exit: {e}"))
    except Exception as e:
        dt = round(time.time() - t0, 2)
        err = "".join(traceback.format_exception_only(type(e), e)).strip()
        print(f"[ERROR] {bdr} en {dt}s -> {err}")
        results.append((bdr, "ERROR", dt, err))
