import zipfile
import io
from pyspark.sql.functions import *

zip_path = "/dbfs/FileStore/103_input_prep_aby.zip"

def read_zip_in_chunks(zip_path, chunk_size_mb=100):
    with zipfile.ZipFile(zip_path, 'r') as z:
        csv_name = z.namelist()[0]   # primer archivo dentro del ZIP
        with z.open(csv_name) as f:
            while True:
                chunk = f.read(chunk_size_mb * 1024 * 1024)
                if not chunk:
                    break
                yield chunk.decode('utf-8', errors='ignore')

chunks_rdd = spark.sparkContext.parallelize(
    list(read_zip_in_chunks(zip_path)),
    numSlices=32
)

lines_rdd = chunks_rdd.flatMap(lambda x: x.splitlines())

df = spark.read.csv(lines_rdd, header=True)
df.show(5)
