val allUsers = spark.sqlContext.table(s"${staging_db}.users_ecresearch")
  .select(col("user_email"), col("user_rol"))
  .collect()
  .groupBy(r => Option(r.getAs[String]("user_rol")).getOrElse("").toUpperCase)
  .mapValues(
    _.flatMap(r =>
      Option(r.getAs[String]("user_email"))
        .map(_.trim.toLowerCase)
        .filter(_.nonEmpty)
    ).distinct.toList
  )
