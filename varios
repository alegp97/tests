@Before
public void beforeMethod() throws Exception {

  // 1) Mock de estáticos del factory
  PowerMockito.mockStatic(VariableResolutionHandlerFactory.class);
  BDDMockito.given(VariableResolutionHandlerFactory.getVariableResolutionHandler())
      .willReturn(variablesResHandler);

  // 2) Stub del translate
  Mockito.when(variablesResHandler.translateQuery(session, execution, querycontent))
      .thenReturn(query);

  // 3) Spy de estáticos de Configuration (IMPORTANTE: spy, no mock puro)
  PowerMockito.spy(Configuration.class);

  // 4) Anula loadJSon (private/static) sin ejecutar cuerpo
  PowerMockito.doNothing()
      .when(Configuration.class, "loadJSon");   // usa el nombre exacto

  // 5) Asegura que getQuery ejecute el método real
  PowerMockito.doCallRealMethod()
      .when(Configuration.class, "getQuery", Mockito.any(), Mockito.any(), Mockito.any());
}
