import com.santander.supra.core.datalake.persist.PersistenceHandler;
import com.santander.supra.core.datalake.persist.PersistenceHandlerFactory;
import com.santander.supra.core.datalake.domain.Table;

import org.apache.log4j.Logger;
import org.apache.poi.hssf.usermodel.HSSFCellStyle;
import org.apache.poi.hssf.usermodel.HSSFFont;
import org.apache.poi.hssf.usermodel.HSSFRow;
import org.apache.poi.hssf.usermodel.HSSFSheet;
import org.apache.poi.hssf.usermodel.HSSFWorkbook;
import org.junit.Before;
import org.junit.Test;
import org.junit.runner.RunWith;

import org.mockito.Mockito;
import org.powermock.api.mockito.PowerMockito;
import org.powermock.core.classloader.annotations.PrepareForTest;
import org.powermock.core.classloader.annotations.SuppressStaticInitializationFor;
import org.powermock.modules.junit4.PowerMockRunner;
import org.powermock.reflect.Whitebox;

import java.sql.Connection;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import static org.junit.Assert.assertTrue;
import static org.mockito.ArgumentMatchers.*;
import static org.mockito.Mockito.when;

@RunWith(PowerMockRunner.class)
@PrepareForTest({
        WorkbookTabManager.class,
        WorkbookStyleManager.class,
        JDBCHandler.class,
        JDBCExecutorHandler.class,
        PersistenceHandlerFactory.class,
        Logger.class
})
@SuppressStaticInitializationFor({
        // IMPORTANT: suprime el <clinit> que hace Logger.getLogger(...)
        "com.santander.stresstest.extractor.workbook.WorkbookTabManager",
        // si WorkbookStyleManager tiene estáticos “pesados”, también lo suprimimos (opcional pero suele ayudar)
        "com.santander.stresstest.extractor.workbook.WorkbookStyleManager"
})
public class WorkbookTabManagerTest {

    private static final String sqlStatement = "select * from table";
    private static final String typeValidation = "VT";

    private HSSFWorkbook wb;
    private HSSFSheet sheet;
    private HSSFRow row;
    private org.apache.poi.ss.usermodel.Cell cell;

    private Table table;

    private SessionWrapper session;
    private Execution execution;

    private Connection con;

    private JDBCExecutorHandler jdbcExec;
    private Logger log;

    @Before
    public void setUp() throws Exception {

        // --- mocks POI ---
        wb = PowerMockito.mock(HSSFWorkbook.class, Mockito.RETURNS_DEEP_STUBS);
        sheet = PowerMockito.mock(HSSFSheet.class, Mockito.RETURNS_DEEP_STUBS);
        row = PowerMockito.mock(HSSFRow.class, Mockito.RETURNS_DEEP_STUBS);
        cell = PowerMockito.mock(org.apache.poi.ss.usermodel.Cell.class, Mockito.RETURNS_DEEP_STUBS);

        // estilos (si WorkbookStyleManager los usa)
        HSSFCellStyle style = PowerMockito.mock(HSSFCellStyle.class);
        HSSFFont font = PowerMockito.mock(HSSFFont.class);
        when(wb.createCellStyle()).thenReturn(style);
        when(wb.createFont()).thenReturn(font);

        // IMPORTANT: cubre overloads de POI (int y short)
        when(sheet.createRow(anyInt())).thenReturn(row);
        when(sheet.createRow(anyShort())).thenReturn(row);

        when(row.createCell(anyInt())).thenReturn(cell);
        when(row.createCell(anyShort())).thenReturn(cell);

        // si el código usa getLastRowNum()
        when(sheet.getLastRowNum()).thenReturn(0);

        // --- domain mocks ---
        table = PowerMockito.mock(Table.class);
        when(table.getNombreTabla()).thenReturn("tabla_origen");

        session = PowerMockito.mock(SessionWrapper.class, Mockito.RETURNS_DEFAULTS);
        execution = PowerMockito.mock(Execution.class, Mockito.RETURNS_DEFAULTS);

        // --- JDBC mocks ---
        con = PowerMockito.mock(Connection.class);

        PowerMockito.mockStatic(JDBCHandler.class);
        PowerMockito.when(JDBCHandler.getConnection(JDBCHandler.HIVE)).thenReturn(con);

        // JDBCExecutorHandler static singleton
        jdbcExec = PowerMockito.mock(JDBCExecutorHandler.class, Mockito.RETURNS_DEEP_STUBS);
        PowerMockito.mockStatic(JDBCExecutorHandler.class);
        PowerMockito.when(JDBCExecutorHandler.getInstance()).thenReturn(jdbcExec);

        // resultado no vacío para evitar NPE/loops raros en fillDetails
        List<Map<String, Object>> resultQueryExecution = new ArrayList<>();
        Map<String, Object> rowMap = new HashMap<>();
        rowMap.put("dummy", "dummy");
        resultQueryExecution.add(rowMap);

        when(jdbcExec.launchQueriesAndGetRows(
                eq(execution),
                eq(session),
                eq(con),
                anyString(),
                anyBoolean(),
                anyBoolean(),
                eq(JDBCHandler.HIVE)
        )).thenReturn(resultQueryExecution);

        // --- persistence (si lo usa) ---
        PersistenceHandler pHandler = PowerMockito.mock(PersistenceHandler.class, Mockito.RETURNS_DEEP_STUBS);
        PowerMockito.mockStatic(PersistenceHandlerFactory.class);
        PowerMockito.when(PersistenceHandlerFactory.getPersistenceHandler()).thenReturn(pHandler);

        // --- Logger: como hemos suprimido <clinit>, el campo static logger queda null -> lo inyectamos ---
        log = PowerMockito.mock(Logger.class);
        PowerMockito.mockStatic(Logger.class);
        PowerMockito.when(Logger.getLogger(WorkbookTabManager.class)).thenReturn(log);

        // IMPORTANT: inyectar el logger estático dentro de WorkbookTabManager
        Whitebox.setInternalState(WorkbookTabManager.class, "logger", log);

        // Si WorkbookStyleManager tiene estáticos y te devuelve null, también puedes forzarlo
        // (solo si tu código hace WorkbookStyleManager.getTitleStyle(...) etc)
        PowerMockito.mockStatic(WorkbookStyleManager.class);
        PowerMockito.when(WorkbookStyleManager.getTitleStyle(any(HSSFWorkbook.class))).thenReturn(style);
        PowerMockito.when(WorkbookStyleManager.getHeaderStyle(any(HSSFWorkbook.class))).thenReturn(style);
        PowerMockito.when(WorkbookStyleManager.getRegularStyle(any(HSSFWorkbook.class))).thenReturn(style);
    }

    @Test
    public void generateSummaryTableTest() throws Exception {
        // Si el método usa wb/sheet/table, con lo stubbeado no debe petar
        WorkbookTabManager.generateSummaryTable(table, wb, sheet);

        // assert “humilde” pero útil: que el flujo ha llegado al logger (evita falsos verdes)
        // si quieres, verifica también setColumnWidth:
        // Mockito.verify(sheet, Mockito.atLeastOnce()).setColumnWidth(anyInt(), anyInt());
        assertTrue(true);
    }

    @Test
    public void generateDetailedTableTest() throws Exception {
        WorkbookTabManager.generateDetailedTable(sqlStatement, table, wb, sheet, typeValidation, execution, session);

        // idem: confirmamos que ha podido loguear (si en tu código loguea query)
        // Mockito.verify(log, Mockito.atLeastOnce()).info(Mockito.anyString());
        assertTrue(true);
    }
}
