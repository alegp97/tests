-- Databricks notebook source
-- MAGIC %sql
-- 0) Selección de catálogo/esquema (ajustar si es necesario)
USE CATALOG samples;
USE SCHEMA nyctaxi;

-- Comprobación rápida del objeto
DESCRIBE TABLE trips;



-- Databricks notebook source
-- MAGIC %sql
-- 1) Perfilado rápido: volumen y rango temporal aproximado
SELECT
  COUNT(*)                                  AS trips_total,
  MIN(tpep_pickup_datetime)                 AS min_pickup,
  MAX(tpep_dropoff_datetime)                AS max_dropoff,
  APPROX_PERCENTILE(trip_distance, 0.5)     AS p50_trip_miles,
  APPROX_PERCENTILE(total_amount, 0.5)      AS p50_total_amount
FROM trips;



