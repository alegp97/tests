# --- Lee valores ---
def _csv_list(name):
    raw = dbutils.widgets.get(name).strip()
    return [x.strip() for x in raw.split(",")] if raw else []

params = {
    "update_file_path": dbutils.widgets.get("update_file_path").strip(),
    "table_name": dbutils.widgets.get("table_name").strip(),
    "data_source": dbutils.widgets.get("data_source").strip(),
    "data_date_part": dbutils.widgets.get("data_date_part").strip(),
    "data_timestamp": dbutils.widgets.get("data_timestamp").strip(),
    "join_fields": _csv_list("join_fields"),
    "fields_to_update": _csv_list("fields_to_update"),
    "fields_updaters": _csv_list("fields_updaters"),
    "new_partition": dbutils.widgets.get("new_partition").lower() == "true",
    "separator": dbutils.widgets.get("separator"),
}

# --- Validaciones clave (fail fast y mensajes claros) ---
errors = []

if not params["update_file_path"].startswith("dbfs:/"):
    errors.append("`update_file_path` debe empezar por `dbfs:/`")
if not params["table_name"]:
    errors.append("`table_name` es obligatorio")
if not params["data_source"]:
    errors.append("`data_source` es obligatorio")
if not params["data_date_part"] or len(params["data_date_part"]) != 10:
    errors.append("`data_date_part` debe tener formato YYYY-MM-DD")
if not params["join_fields"]:
    errors.append("`join_fields` no puede estar vacío (usa coma)")

if not params["fields_to_update"]:
    errors.append("`fields_to_update` no puede estar vacío")
if len(params["fields_to_update"]) != len(params["fields_updaters"]):
    errors.append("`fields_to_update` y `fields_updaters` deben tener misma longitud y orden 1:1")

if not params["new_partition"] and not params["data_timestamp"]:
    errors.append("Si `new_partition` = false, debes indicar `data_timestamp` objetivo")

if errors:
    raise ValueError("Parámetros inválidos:\n- " + "\n- ".join(errors))

