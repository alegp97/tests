import org.apache.hadoop.fs.{FileSystem, Path}
import java.io.{BufferedReader, InputStreamReader, OutputStreamWriter}
import com.opencsv.{CSVReader, CSVWriter}

def processCsv(fs: FileSystem,
               csvIn: Path,
               csvOut: Path,
               csvDelimiter: Char): Unit = {

  val inStream  = fs.open(csvIn)
  val reader    = new CSVReader(new BufferedReader(new InputStreamReader(inStream)), csvDelimiter)

  val outStream = fs.create(csvOut, true)    // overwrite = true
  val writer    = new CSVWriter(new OutputStreamWriter(outStream))

  try {
    var line: Array[String] = reader.readNext()
    while (line != null) {

      // aquí haces tus transformaciones
      val processed = line.map(_.trim)

      writer.writeNext(processed, false)
      line = reader.readNext()
    }
  } finally {
    writer.close()
    reader.close()
  }
}
